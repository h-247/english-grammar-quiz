# ==============================================================================
# English Grammar Quiz - ChatGPT Sites / Vinext Environment Template
# ==============================================================================
# The application runs on the Cloudflare Workers runtime with Cloudflare D1.
# Local development uses persistent Miniflare D1 emulation configured in .openai/hosting.json.
# No secrets or database URLs are required for standard local operation.

# Optional: Port override for local development server (default: 3100)
PORT=3100

# Optional: Next.js public API URL override (defaults to same-origin relative '/api')
# NEXT_PUBLIC_API_URL=
